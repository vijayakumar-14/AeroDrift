# Copy this file to .env and fill in the correct local values.
# Windows example: SERIAL_PORT=COM5
# Linux example:   SERIAL_PORT=/dev/ttyUSB0
# macOS example:   SERIAL_PORT=/dev/cu.usbserial-0001
SERIAL_PORT=COM5
SERIAL_BAUD=115200
FIREBASE_DATABASE_URL=https://YOUR_DATABASE_NAME.YOUR_REGION.firebasedatabase.app
# Path to a service-account JSON stored OUTSIDE the public website repo if possible.
# Windows example: FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/you/keys/aerodrift-service-account.json
# macOS/Linux example: FIREBASE_SERVICE_ACCOUNT_PATH=/Users/you/keys/aerodrift-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
HISTORY_MIN_INTERVAL_MS=2000
